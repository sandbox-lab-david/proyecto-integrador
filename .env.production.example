# Plantilla del .env para el servidor de producción.
# Copiar como .env en el servidor y completar los valores marcados con CAMBIAR.
# Nunca subir el .env real al repositorio.

APP_NAME="Solicitudes UEES"
# production evita que el seeder cree usuarios, mallas, periodos y paralelos de prueba.
APP_ENV=production
# Generar con: php artisan key:generate
APP_KEY=
# false: un error muestra una página genérica, no el código ni las claves.
APP_DEBUG=false
# Dirección pública con https. Los enlaces de los correos apuntan aquí.
APP_URL=https://CAMBIAR.uees.edu.ec
APP_TIMEZONE=America/Guayaquil

# Igual que en local: el proyecto no trae archivos de traducción, así que no cambiar a es.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# daily guarda un archivo de log por día en storage/logs y borra los antiguos.
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# Usuario propio para la aplicación, con contraseña fuerte (no usar postgres).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=solicitudes_uees
DB_USERNAME=CAMBIAR
DB_PASSWORD=CAMBIAR

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# La sesión solo viaja por https.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Necesita "php artisan queue:work" encendido como servicio:
# sin él no salen correos ni notificaciones, ni se procesan las cargas grandes.
QUEUE_CONNECTION=database

CACHE_STORE=database

# Servidor de correo real (lo entrega el área de TI de la universidad).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=CAMBIAR
MAIL_PORT=587
MAIL_USERNAME=CAMBIAR
MAIL_PASSWORD=CAMBIAR
# Remitente de los correos (enlaces de contraseña y avisos).
MAIL_FROM_ADDRESS="CAMBIAR@uees.edu.ec"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Chatbot: servidor SWI-Prolog (prolog/kb/servidor.pl).
# En producción la clave es obligatoria: la misma aquí y al arrancar Prolog
# (mínimo 16 caracteres). Prolog no debe arrancarse con PROLOG_ENTORNO=desarrollo.
PROLOG_API_URL=http://127.0.0.1:8081
PROLOG_API_KEY=CAMBIAR
PROLOG_TIMEOUT=5.0
CHATBOT_ROLES=estudiante
